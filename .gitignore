assets/
dlc/
generated/
# Anchored: the vendored SDK tracks scripts/PSReX/Private/, which an
# unanchored rule would swallow on a case-insensitive filesystem.
/private/
out/
# The vendored SDK's own untracked build tree (the SDK never ignored it itself).
/thirdparty/rexglue-sdk/build/
*.user
.vs/
CMakeSettings.json
legacy/

# Transient XenonRecomp reference maps + codegen logs (regenerate via
# scripts/build_module_hints.sh). 254MB of derived data.
scripts/module_maps/

# Scratch soak/smoke drivers + their report/sample outputs (not part of the build).
soak_tools/

# Python bytecode caches from the helper scripts in scripts/.
__pycache__/
*.pyc

# Renut leg 2: XenosRecomp builds zstd with ZSTD_LEGACY_SUPPORT=ON (the vendored tree must stay complete)
!thirdparty/reblue-XenosRecomp/thirdparty/zstd/lib/legacy/

# dxc-bin binaries (renderbag/dxc-bin 737ac9f, XenosRecomp's submodule; copy them in from a XenosRecomp checkout, never commit them)
thirdparty/reblue-XenosRecomp/thirdparty/dxc-bin/bin/
thirdparty/reblue-XenosRecomp/thirdparty/dxc-bin/lib/
